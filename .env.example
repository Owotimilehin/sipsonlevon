# ── Database (required) ─────────────────────────────────────────────
# Must be a POOLED connection string on serverless, or warm instances
# will exhaust Postgres' connection limit.
#   Neon:     ...-pooler.<region>.aws.neon.tech/...
#   Supabase: port 6543 (the "Transaction pooler" string)
DATABASE_URL=

# ── Customer account sessions (required) ────────────────────────────
# HMAC key for the sl_user cookie. Changing it signs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCOUNT_SECRET=

# ── Atelier / staff desk (required) ─────────────────────────────────
# QUOTE any value containing #, or dotenv treats the rest as a comment.
ADMIN_PASSWORD="change-me-before-deploy"
ADMIN_TOKEN=change-me-before-deploy

# ── Public origin (required) ────────────────────────────────────────
# Used to build OPay return and callback URLs. Must be public HTTPS in
# production or OPay callbacks cannot reach you.
SITE_URL=http://localhost:3000

# ── OPay Cashier (optional) ─────────────────────────────────────────
# From the OPay merchant dashboard, under API Keys & Webhooks.
# Leave blank to run without payments: checkout then marks orders paid
# locally, which is fine for development and never for production.
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_ENV=sandbox
